# Optional cloud account & relay settings (LAN/QR pairing works without these).
# Pass via Gradle properties (-PaetherSupabaseUrl=...) or environment variables.
AETHER_SUPABASE_URL=https://your-project.supabase.co
AETHER_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
AETHER_ACCOUNT_RELAY_URL=wss://your-account-relay.workers.dev

# Release APK signing variables
KEYSTORE_PATH=path/to/release.jks
STORE_PASSWORD=your-store-password
KEY_ALIAS=aether
KEY_PASSWORD=your-key-password
