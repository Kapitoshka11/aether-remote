{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aether-account-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "vars": {
    "SUPABASE_URL": "",
    "SUPABASE_PUBLISHABLE_KEY": ""
  },
  "durable_objects": { "bindings": [{ "name": "ACCOUNT_TUNNELS", "class_name": "AccountTunnel" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountTunnel"] }],
  "ratelimits": [{ "name": "JOIN_LIMITER", "namespace_id": "7423199", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": false }
}
