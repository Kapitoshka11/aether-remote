    "ACCOUNT_HELLO": {
      "description": "Account handshake over pinned TLS. Access token required for first enrollment; a locally approved grant permits offline LAN reconnect. See PROTOCOL.md account section.",
      "request": {
        "type": "object",
        "required": [
          "action",
          "ownerId",
          "hostId",
          "phoneId",
          "sessionId"
        ],
        "properties": {
          "action": {
            "const": "ACCOUNT_HELLO"
          },
          "ownerId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "hostId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "phoneId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sessionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "grantId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "accessToken": {
            "type": "string",
            "maxLength": 16384
          },
          "capabilities": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      },
      "response": {
        "description": "ACCOUNT_CHALLENGE followed by optional ACCOUNT_APPROVAL_PENDING, then account AUTH_OK or AUTH_REJECTED"
      }
    },
    "ACCOUNT_PROOF": {
      "description": "Single-use P-256 proof bound to owner, devices, session, transport, grant, nonce and expiry. DER ECDSA SHA-256 encoded as unpadded base64url.",
      "request": {
        "type": "object",
        "required": [
          "action",
          "version",
          "ownerId",
          "hostId",
          "phoneId",
          "sessionId",
          "grantId",
          "transport",
          "nonce",
          "expiresAt",
          "signature"
        ],
        "properties": {
          "action": {
            "const": "ACCOUNT_PROOF"
          },
          "version": {
            "const": 1
          },
          "ownerId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "hostId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "phoneId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sessionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "grantId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "transport": {
            "enum": [
              "lan",
              "relay"
            ]
          },
          "nonce": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "expiresAt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{90,100}$"
          }
        }
      }
    }
  }
}
